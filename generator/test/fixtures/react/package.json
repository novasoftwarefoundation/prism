{
  "name": "example-components-react",
  "private": true,
  "description": "The example design's React components, as the React target generates them, with their tests",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "check": "tsc --noEmit -p test",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
