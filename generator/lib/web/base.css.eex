<%= doc_block(web.base_doc) %>/* ==========================================================================
   Font Faces
   ========================================================================== */
<%= for face <- font_faces(design) do %>
<%= if face.first do %>/* <%= comment!(face_note(face)) %> */
<% end %>@font-face {
  font-family: <%= css_str(face.family) %>;
<%= font_src(face, web) %>
  font-weight: <%= face.weights %>;
  font-style: <%= face.style %>;
  font-display: swap;
}
<% end %>
/* ==========================================================================
   Utility Classes
   ========================================================================== */

<%= if web.line_clamps > 0 do %>/* Text line clamping */<%= for n <- 1..web.line_clamps do %>
.<%= web.prefix %>-max-lines-<%= n %> {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: <%= n %>;
  -webkit-box-orient: vertical;
}
<% end %>
<% end %>/* Text shadows */<%= for {class, css} <- text_shadows(design, web) do %>
.<%= class %> {
  text-shadow: <%= css %>;
}
<% end %>
.<%= web.prefix %>-text-shadow-none {
  text-shadow: none;
}
