/** A side of the content, in the text's direction: start is left in a left-to-right text. */
public enum class <%= @m %>Side { Start, End }

/**
 * Space on each side, in dp; a side left `null` is not set, so a look laid over
 * another keeps that side. Start and end follow the text's direction.
 */
@Immutable
public data class <%= @m %>Insets(
    val top: Dp? = null,
    val start: Dp? = null,
    val bottom: Dp? = null,
    val end: Dp? = null,
) {
    /** These insets with `other`'s sides in place where it sets them. */
    public operator fun plus(other: <%= @m %>Insets): <%= @m %>Insets =
        <%= @m %>Insets(
            other.top ?: top, other.start ?: start, other.bottom ?: bottom, other.end ?: end)

    /** The insets as padding, `extra` added on the `sides` given. */
    public fun paddingValues(extra: Dp = 0.dp, sides: <%= @m %>Sides = <%= @m %>Sides.All): PaddingValues =
        PaddingValues(
            start = (start ?: 0.dp) + if (sides.start) extra else 0.dp,
            top = (top ?: 0.dp) + if (sides.top) extra else 0.dp,
            end = (end ?: 0.dp) + if (sides.end) extra else 0.dp,
            bottom = (bottom ?: 0.dp) + if (sides.bottom) extra else 0.dp,
        )

    internal val isEmpty: Boolean
        get() = top == null && start == null && bottom == null && end == null
}

/** The sides a border is on; start and end follow the text's direction. */
@Immutable
public data class <%= @m %>Sides(
    val top: Boolean = false,
    val start: Boolean = false,
    val bottom: Boolean = false,
    val end: Boolean = false,
) {
    public companion object {
        /** Every side. */
        public val All: <%= @m %>Sides = <%= @m %>Sides(top = true, start = true, bottom = true, end = true)
    }

    internal val isAll: Boolean get() = top && start && bottom && end
}

/** A corner radius: a length, or the full radius of a capsule (50% of the shorter side). */
@Immutable
public sealed interface <%= @m %>Radius {
    /** A radius of `value`. */
    public data class Fixed(val value: Dp) : <%= @m %>Radius

    /** Half the shorter side: a capsule, or a circle on a square. */
    public data object Full : <%= @m %>Radius

    /** The shape of a box with this radius. */
    public val shape: Shape
        get() = when (this) {
            is Fixed -> if (value == 0.dp) RectangleShape else RoundedCornerShape(value)
            Full -> CircleShape
        }
}

/** The width of a line the component draws: a length, or a fraction of the box it is drawn in. */
@Immutable
public sealed interface <%= @m %>Stroke {
    /** A width of `value`. */
    public data class Fixed(val value: Dp) : <%= @m %>Stroke

    /** A fraction of the side of the box. */
    public data class Fraction(val value: Float) : <%= @m %>Stroke

    /** The width in a box of `side`. */
    public fun width(side: Dp): Dp = when (this) {
        is Fixed -> value
        is Fraction -> side * value
    }
}

/** A shadow, as CSS's box shadow: an offset, a blur, a spread, and inside the box or outside it. */
@Immutable
public data class <%= @m %>Shadow(
    val color: Color,
    val x: Dp = 0.dp,
    val y: Dp = 0.dp,
    val blur: Dp = 0.dp,
    val spread: Dp = 0.dp,
    val inset: Boolean = false,
) {
    /** The shadow for `Modifier.dropShadow` or `Modifier.innerShadow`. */
    public val shadow: Shadow
        get() = Shadow(radius = blur, color = color, spread = spread, offset = DpOffset(x, y))
}

/** A line under the text, or none. */
public enum class <%= @m %>Decoration { Underline, None }

/** An easing of a motion, named as CSS names it. */
public enum class <%= @m %>Easing { Linear, EaseIn, EaseOut, EaseInOut }

/** How a look changes from one state to the next: its duration and easing, as CSS's. */
@Immutable
public data class <%= @m %>Motion(val durationMillis: Int, val easing: <%= @m %>Easing) {
    /** The easing curve, CSS's for each name. */
    public val curve: Easing
        get() = when (easing) {
            <%= @m %>Easing.Linear -> LinearEasing
            <%= @m %>Easing.EaseIn -> CubicBezierEasing(0.42f, 0f, 1f, 1f)
            <%= @m %>Easing.EaseOut -> CubicBezierEasing(0f, 0f, 0.58f, 1f)
            <%= @m %>Easing.EaseInOut -> CubicBezierEasing(0.42f, 0f, 0.58f, 1f)
        }

    /** The animation of a value over this motion. */
    public fun <T> spec(): FiniteAnimationSpec<T> = tween(durationMillis, easing = curve)
}

/** What a font's text is for, and so how much it stands out, lightest first. */
public enum class <%= @m %>Emphasis { <%= Enum.join(@emphases_cases, ", ") %> }

/** A font family as Android binds it, with the weight of each emphasis in it. */
@Immutable
public data class <%= @m %>FontFamily(
    val font: FontFamily,
<%= for e <- @emphases do %>    val <%= e %>: Int,
<% end %>) {
    /** The weight of `emphasis` in this family. */
    public fun weight(emphasis: <%= @m %>Emphasis): Int = when (emphasis) {
<%= for {e, c} <- Enum.zip(@emphases, @emphases_cases) do %>        <%= @m %>Emphasis.<%= c %> -> <%= e %>
<% end %>    }
}

/**
 * A typography: a family, an emphasis, italic or not, and a size and line height in sp,
 * which follow the user's font size.
 */
@Immutable
public data class <%= @m %>Typography(
    val family: <%= @m %>FontFamily,
    val emphasis: <%= @m %>Emphasis,
    val italic: Boolean,
    val size: TextUnit,
    val lineHeight: TextUnit,
) {
    /** The weight the text is drawn at: the family's for its emphasis. */
    public val weight: Int get() = family.weight(emphasis)

    /** This typography with another emphasis. */
    public fun emphasis(emphasis: <%= @m %>Emphasis): <%= @m %>Typography = copy(emphasis = emphasis)

    /**
     * The text style: the line as high as the line height, the text in its middle, as on
     * the web, where a box around the text is as high as its lines.
     */
    public val textStyle: TextStyle
        get() = TextStyle(
            fontFamily = family.font,
            fontWeight = FontWeight(weight),
            fontStyle = if (italic) FontStyle.Italic else FontStyle.Normal,
            fontSize = size,
            lineHeight = lineHeight,
            lineHeightStyle = LineHeightStyle(
                alignment = LineHeightStyle.Alignment.Center,
                trim = LineHeightStyle.Trim.None,
            ),
        )
}

/**
 * A look as data: what the design gives one element in one choice of its variants,
 * flags, parts and states. A property left `null` is not set, so a look laid over another
 * with `+` keeps the other's.
 */
@Immutable
public data class <%= @m %>Look(
    val background: Color? = null,
    val foreground: Color? = null,
    val placeholder: Color? = null,
    val borderWidth: Dp? = null,
    val borderColor: Color? = null,
    val borderSides: <%= @m %>Sides? = null,
    val outlineWidth: Dp? = null,
    val outlineColor: Color? = null,
    val outlineOffset: Dp? = null,
    val radius: <%= @m %>Radius? = null,
    val padding: <%= @m %>Insets = <%= @m %>Insets(),
    val margin: <%= @m %>Insets = <%= @m %>Insets(),
    val inset: <%= @m %>Insets = <%= @m %>Insets(),
    val gap: Dp? = null,
    val size: Dp? = null,
    val width: Dp? = null,
    val height: Dp? = null,
    val minHeight: Dp? = null,
    val maxHeight: Dp? = null,
    val typography: <%= @m %>Typography? = null,
    val emphasis: <%= @m %>Emphasis? = null,
    val decoration: <%= @m %>Decoration? = null,
    val shadow: <%= @m %>Shadow? = null,
    val opacity: Float? = null,
    val transition: <%= @m %>Motion? = null,
    val rotation: <%= @m %>Motion? = null,
    val stroke: <%= @m %>Stroke? = null,
    val track: Color? = null,
) {
    /** This look with `other`'s properties in place where it sets them. */
    public operator fun plus(other: <%= @m %>Look): <%= @m %>Look = <%= @m %>Look(
        background = other.background ?: background,
        foreground = other.foreground ?: foreground,
        placeholder = other.placeholder ?: placeholder,
        borderWidth = other.borderWidth ?: borderWidth,
        borderColor = other.borderColor ?: borderColor,
        borderSides = other.borderSides ?: borderSides,
        outlineWidth = other.outlineWidth ?: outlineWidth,
        outlineColor = other.outlineColor ?: outlineColor,
        outlineOffset = other.outlineOffset ?: outlineOffset,
        radius = other.radius ?: radius,
        padding = padding + other.padding,
        margin = margin + other.margin,
        inset = inset + other.inset,
        gap = other.gap ?: gap,
        size = other.size ?: size,
        width = other.width ?: width,
        height = other.height ?: height,
        minHeight = other.minHeight ?: minHeight,
        maxHeight = other.maxHeight ?: maxHeight,
        typography = other.typography ?: typography,
        emphasis = other.emphasis ?: emphasis,
        decoration = other.decoration ?: decoration,
        shadow = other.shadow ?: shadow,
        opacity = other.opacity ?: opacity,
        transition = other.transition ?: transition,
        rotation = other.rotation ?: rotation,
        stroke = other.stroke ?: stroke,
        track = other.track ?: track,
    )

    /** The look without its padding, for a box whose content has the padding instead. */
    public val withoutPadding: <%= @m %>Look get() = copy(padding = <%= @m %>Insets())

    /** The typography the text is drawn in: the look's, with its emphasis on top. */
    public val font: <%= @m %>Typography?
        get() {
            val typography = typography ?: return null
            return emphasis?.let { typography.emphasis(it) } ?: typography
        }

    /** The shape of the box: its radius's, or a rectangle. */
    public val shape: Shape get() = radius?.shape ?: RectangleShape

    /**
     * The text style of the look: its typography, color and decoration over `base`, the
     * text style around it.
     */
    public fun textStyle(base: TextStyle): TextStyle {
        var style = font?.let { base.merge(it.textStyle) } ?: base
        foreground?.let { style = style.copy(color = it) }
        when (decoration) {
            <%= @m %>Decoration.Underline ->
                style = style.copy(textDecoration = TextDecoration.Underline)
            <%= @m %>Decoration.None -> style = style.copy(textDecoration = TextDecoration.None)
            null -> {}
        }
        return style
    }
}

/**
 * The look with its colors and opacity animated to it over its `transition`, as the web's
 * transition does; at once without one. Its other properties change at once.
 */
@Composable
public fun <%= @m %>Look.animated(): <%= @m %>Look {
    val motion = transition ?: return this
    val background by animateColorAsState(background ?: Color.Transparent, motion.spec())
    val foreground by animateColorAsState(foreground ?: Color.Transparent, motion.spec())
    val borderColor by animateColorAsState(borderColor ?: Color.Transparent, motion.spec())
    val opacity by animateFloatAsState(opacity ?: 1f, motion.spec())
    return copy(
        background = this.background?.let { background },
        foreground = this.foreground?.let { foreground },
        borderColor = this.borderColor?.let { borderColor },
        opacity = this.opacity?.let { opacity },
    )
}

/**
 * Draws a look's box around the content: its margin, size, opacity, shadow, background,
 * border, outline and padding. The border is inside the box, so the padding and size are
 * CSS's border box. A look with text has its height as the least it takes, so it grows
 * with the user's font size instead of cutting its text off.
 */
public fun Modifier.<%= @lower %>Box(look: <%= @m %>Look): Modifier {
    val shape = look.shape
    val border = look.borderWidth ?: 0.dp
    var modifier = this
    if (!look.margin.isEmpty) modifier = modifier.padding(look.margin.paddingValues())
    look.size?.let { modifier = modifier.size(it) }
    look.width?.let { modifier = modifier.width(it) }
    val least = look.minHeight
    val text = look.typography != null
    val height = look.height
    when {
        height != null && text -> modifier = modifier.heightIn(min = max(height, least ?: 0.dp))
        height != null -> modifier = modifier.height(height)
        least != null || look.maxHeight != null ->
            modifier = modifier.heightIn(
                min = least ?: Dp.Unspecified,
                max = look.maxHeight ?: Dp.Unspecified,
            )
    }
    if (look.height != null && text && look.maxHeight != null) {
        modifier = modifier.requiredHeightIn(max = look.maxHeight)
    }
    look.opacity?.let { modifier = modifier.alpha(it) }
    look.shadow?.takeIf { !it.inset }?.let { modifier = modifier.dropShadow(shape, it.shadow) }
    look.background?.let { modifier = modifier.background(it, shape) }
    val color = look.borderColor
    if (color != null && border > 0.dp) {
        val sides = look.borderSides ?: <%= @m %>Sides.All
        modifier = if (sides.isAll) {
            modifier.border(border, color, shape)
        } else {
            modifier.sideBorders(border, color, sides)
        }
    }
    look.shadow?.takeIf { it.inset }?.let { modifier = modifier.innerShadow(shape, it.shadow) }
    val outline = look.outlineWidth
    val outlineColor = look.outlineColor
    if (outline != null && outlineColor != null && outline > 0.dp) {
        modifier = modifier.outline(outline, outlineColor, look.outlineOffset ?: 0.dp, look.radius)
    }
    return modifier.padding(look.padding.paddingValues(border, look.borderSides ?: <%= @m %>Sides.All))
}

// A border on some sides only: a line on each, inside the box.
private fun Modifier.sideBorders(width: Dp, color: Color, sides: <%= @m %>Sides): Modifier =
    drawBehind {
        val w = width.toPx()
        val rtl = layoutDirection == LayoutDirection.Rtl
        val left = if (rtl) sides.end else sides.start
        val right = if (rtl) sides.start else sides.end
        if (sides.top) drawRect(color, Offset.Zero, size.copy(height = w))
        if (sides.bottom) drawRect(color, Offset(0f, size.height - w), size.copy(height = w))
        if (left) drawRect(color, Offset.Zero, size.copy(width = w))
        if (right) drawRect(color, Offset(size.width - w, 0f), size.copy(width = w))
    }

// An outline: a line outside the box, `offset` from it, as CSS draws one.
private fun Modifier.outline(
    width: Dp,
    color: Color,
    offset: Dp,
    radius: <%= @m %>Radius?,
): Modifier = drawBehind {
    val w = width.toPx()
    val out = offset.toPx() + w / 2
    val corner = when (radius) {
        is <%= @m %>Radius.Fixed -> radius.value.toPx() + out
        <%= @m %>Radius.Full -> minOf(size.width, size.height) / 2 + out
        null -> 0f
    }
    drawRoundRect(
        color,
        topLeft = Offset(-out, -out),
        size = size.copy(width = size.width + 2 * out, height = size.height + 2 * out),
        cornerRadius = CornerRadius(corner),
        style = Stroke(w),
    )
}

/**
 * Gives the content the look's text: its typography, color and decoration, as the text
 * style and content color Material's `Text` and `Icon` read.
 */
@Composable
public fun <%= @m %>Text(look: <%= @m %>Look, content: @Composable () -> Unit) {
    val style = look.textStyle(LocalTextStyle.current)
    CompositionLocalProvider(
        LocalTextStyle provides style,
        LocalContentColor provides (look.foreground ?: LocalContentColor.current),
        content = content,
    )
}

/** Draws a look on its content: the look's box around it, and its text. */
@Composable
public fun <%= @m %>LookBox(
    look: <%= @m %>Look,
    modifier: Modifier = Modifier,
    content: @Composable () -> Unit,
) {
    Box(modifier.<%= @lower %>Box(look)) { <%= @m %>Text(look, content) }
}
